{
  "name": "spl-syntax",
  "version": "0.1.0",
  "description": "Splunk SPL syntax highlighting for Obsidian code blocks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "oxlint src --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run lint && npm run typecheck && node esbuild.config.mjs production",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "splunk",
    "spl",
    "siem",
    "syntax-highlighting"
  ],
  "author": "Caio Lopes",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/prismjs": "^1.26.6",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "obsidian": "1.13.1",
    "oxlint": "^1.76.0",
    "prismjs": "^1.30.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
